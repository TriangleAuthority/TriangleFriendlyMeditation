<?xml version="1.0" encoding="UTF-8"?>
<UserConfig>
<!-- Friendly Meditation's Key Bindings entries, in a file of its own instead of an edit of the game's input.xml.
     The keys themselves are input.settings lines the player adds by hand (legacy's input.settings.part.txt). -->
	<Group builder="Input" id="PCInput" displayName="controls_pc" tags="keybinds">
		<VisibleVars>
			<Var builder="Input" id="ToggleSpawnCampFire"		displayName="ToggleSpawnCampFire"				displayType="INPUTPC" actions="ToggleSpawnCampFire" />
		</VisibleVars>
	</Group>
</UserConfig>
